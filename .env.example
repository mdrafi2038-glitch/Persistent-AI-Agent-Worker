# Set a strong password before deploying.
APP_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Choose one provider mode:
# Anthropic direct:
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Or an OpenAI-compatible gateway (e.g. your OmniRoute/OpenRouter endpoint):
# AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Supabase is required for persistent conversation history.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional:
PORT=3000
MAX_OUTPUT_TOKENS=1200
